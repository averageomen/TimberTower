{
  "name": "jenga-client",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Timber Stack — 3D Physics Multiplayer Jenga Desktop & Web Client",
  "author": "Timber Stack",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "tsc -b && vite build",
    "build:exe": "tsc -b && vite build && electron-builder --win --x64",
    "dist": "tsc -b && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/rapier": "^2.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.474.0",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.timberstack.jenga",
    "productName": "Timber Stack Jenga",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TimberStack-Jenga-Portable.exe"
    },
    "nsis": {
      "artifactName": "TimberStack-Jenga-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
